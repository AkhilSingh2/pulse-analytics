# Local Postgres from docker compose, or any Postgres you already run.
DATABASE_URL=postgresql://pulse:pulse@localhost:5432/pulse

# Demo ingest key. The dashboard shows it so the browser SDK can send events.
# It is not a production secret. Do not reuse it anywhere real.
PULSE_API_KEY=pulse_live_demo_northstar

# small = faster seed for CI. demo = the rich dataset the screenshots use.
SEED_PROFILE=demo

# Where the live simulator posts batches. Defaults to the local Next server.
PULSE_INGEST_URL=http://127.0.0.1:3000/api/ingest
